<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.14.17</Version>
    <Product>BingeX</Product>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/noctistt/BingeX</RepositoryUrl>
    <Description>BingeX media player</Description>
    <ApplicationIcon>Assets/BingeX.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/BingeX.ico" />
    <AvaloniaResource Include="Assets/BingeX.png" />
    <EmbeddedResource Include="Assets/cloudstream-*.json" />
    <EmbeddedResource Include="Assets/cloudstream-patch.jar" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
</Project>
