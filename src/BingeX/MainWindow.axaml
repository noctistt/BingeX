<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BingeX"
        x:Class="BingeX.MainWindow" Icon="/Assets/BingeX.ico" Title="BingeX" Width="1240" Height="820"
        MinWidth="960" MinHeight="680" Background="#101018">
  <Grid x:Name="RootLayout" ColumnDefinitions="205,*" RowDefinitions="*,Auto">
    <Border x:Name="Sidebar" Background="#161620" Padding="22,30" Grid.RowSpan="2">
      <StackPanel Spacing="16">
        <TextBlock Text="BingeX" FontSize="30" FontWeight="Bold" Foreground="#B69AFF" />
        <TextBlock Text="YOUR NEXT GREAT WATCH" FontSize="9" LetterSpacing="1" Classes="muted" Margin="0,0,0,28" />
        <Button x:Name="LibraryNav" Classes="nav active" Content="Home" Click="Library_Click" HorizontalAlignment="Stretch" />
        <Button x:Name="LocalLibraryNav" Classes="nav" Content="My Library" Click="LocalLibrary_Click" HorizontalAlignment="Stretch" />
        <Button x:Name="PlayerNav" Classes="nav" Content="Player" Click="Player_Click" HorizontalAlignment="Stretch" />
        <Button x:Name="AddonsNav" Classes="nav" Content="Add-ons" Click="Addons_Click" HorizontalAlignment="Stretch" />
        <Border Height="1" Background="#30303F" Margin="0,18" />
        <TextBlock Text="LOCAL. OPEN. YOURS." Classes="muted" FontSize="10" />
        <TextBlock Text="Development preview 0.13.13" Classes="muted" FontSize="11" />
      </StackPanel>
    </Border>
    <Grid x:Name="MainContent" Grid.Column="1" Margin="30,24" RowDefinitions="Auto,*">
      <Grid x:Name="PageHeader" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
        <StackPanel>
          <Button x:Name="NavigateBackButton" Content="← Back" Click="NavigateBack_Click" IsVisible="False" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip.Tip="Back (Alt+Left)" />
          <TextBlock x:Name="PageTitle" Text="Home" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Text="Something worth pressing play for." Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <ToggleSwitch x:Name="OnlineModeSwitch" Content="Online mode" IsChecked="False" VerticalAlignment="Center" ToolTip.Tip="Show online catalogs, add-ons and subtitle search. Your data is kept when off." />
          <Button Content="+ Open media" Classes="primary" Click="Open_Click" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="LibraryPage" Grid.Row="1">
        <StackPanel Spacing="20">
          <Border x:Name="WelcomeHero" CornerRadius="18" Padding="28">
            <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#382657" Offset="0" /><GradientStop Color="#172B39" Offset="1" /></LinearGradientBrush></Border.Background>
            <StackPanel Spacing="12">
              <TextBlock x:Name="WelcomeTitle" Text="Find your next obsession." FontSize="30" FontWeight="SemiBold" />
              <TextBlock Text="Your files. Your favorite stories. One place to press play." TextWrapping="Wrap" Foreground="#D4CEE4" />
              <WrapPanel>
                <Button Content="Open a video" Classes="primary" Click="Open_Click" Margin="0,0,10,0" />
                <Button x:Name="ConnectCatalogButton" Content="Connect movie catalog" Click="ConnectCatalog_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <StackPanel x:Name="HistorySection" Spacing="16">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="Continue watching" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="HistoryPrevious" Grid.Column="1" Content="←" Click="HistoryPrevious_Click" AutomationProperties.Name="Previous recently watched videos" Margin="0,0,8,0" />
              <Button x:Name="HistoryNext" Grid.Column="2" Content="→" Click="HistoryNext_Click" AutomationProperties.Name="More recently watched videos" />
            </Grid>
            <TextBlock x:Name="EmptyHistory" Text="Your recently played files will appear here." Classes="muted" />
            <ScrollViewer x:Name="HistoryScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ScrollChanged="HistoryScrolled">
              <StackPanel x:Name="HistoryItems" Orientation="Horizontal" />
            </ScrollViewer>
          </StackPanel>
          <StackPanel x:Name="DiscoverSection" Spacing="20">
          <TextBlock x:Name="CatalogProviderStatus" Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <StackPanel Spacing="5">
              <TextBlock Text="Discover" FontSize="24" FontWeight="SemiBold" />
              <TextBlock x:Name="DiscoverHint" Text="Explore catalogs from your installed add-ons." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Click="RefreshCatalogs_Click" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Spacing="4">
            <WrapPanel x:Name="DiscoverAddons" />
            <WrapPanel x:Name="DiscoverTypes" />
          </StackPanel>
          <ComboBox x:Name="CatalogPicker" PlaceholderText="Choose a catalog" HorizontalAlignment="Stretch" SelectionChanged="CatalogChanged">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox x:Name="SearchInput" Watermark="Search movies and series…" KeyDown="Search_KeyDown" />
            <Button Grid.Column="1" Content="Search" Classes="primary" Click="Search_Click" Margin="10,0,0,0" />
            <Button Grid.Column="2" Content="Clear" Click="ClearSearch_Click" Margin="10,0,0,0" />
          </Grid>
          <StackPanel x:Name="BrowseBusy" IsVisible="False" Spacing="8">
            <ProgressBar IsIndeterminate="True" Height="3" Foreground="#A78BFA" />
            <TextBlock x:Name="BrowseLoadingText" Text="Loading your catalogs…" Classes="muted" />
          </StackPanel>
          <TextBlock x:Name="BrowseMessage" Text="Connect a catalog to discover movies and series. Local playback is always available." Classes="muted" TextWrapping="Wrap" />
          <Button x:Name="BrowseRetry" Content="Try again" Click="RetryBrowse_Click" IsVisible="False" HorizontalAlignment="Left" />
          <WrapPanel x:Name="PosterGrid" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="LocalLibraryPage" Grid.Row="1" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
          <Border Background="#251D36" CornerRadius="16" Padding="22">
            <StackPanel Spacing="10">
              <TextBlock Text="Your videos, together." FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="Add a folder to find its videos, including subfolders. Your files stay where they are." Foreground="#C8BFDC" TextWrapping="Wrap" />
              <WrapPanel><Button Content="+ Add folder" Classes="primary" Click="AddMediaFolder_Click" Margin="0,0,10,0" /><Button Content="Rescan folders" Click="RescanMediaFolders_Click" Margin="0,0,10,0" /><Button Content="Clear unused video cache" Click="ClearVideoCache_Click" /></WrapPanel>
            </StackPanel>
          </Border>
          <StackPanel x:Name="MediaFolderItems" Spacing="8" />
          <ProgressBar x:Name="LocalScanBusy" IsVisible="False" IsIndeterminate="True" Height="3" Foreground="#B69AFF" />
          <TextBlock x:Name="LocalScanMessage" Foreground="#BFB5D1" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="LocalVideoSearch" Watermark="Search your videos…" TextChanged="LocalVideoSearchChanged" AutomationProperties.Name="Search local videos" />
            <ComboBox x:Name="LocalFolderFilter" Grid.Column="1" Width="190" Margin="10,0,0,0" SelectionChanged="LocalFolderFilterChanged" AutomationProperties.Name="Filter library folder" />
          </Grid>
          <ComboBox x:Name="LocalSort" SelectedIndex="0" SelectionChanged="LocalFolderFilterChanged" AutomationProperties.Name="Sort local videos" Width="220">
            <ComboBoxItem Content="Name" /><ComboBoxItem Content="Recently added" /><ComboBoxItem Content="Last watched" />
          </ComboBox>
          <TextBlock x:Name="LocalVideoCount" Foreground="#BFB5D1" />
          <TextBlock x:Name="LocalLibraryEmpty" Text="Add your first folder to build your library." Foreground="#AAA0BA" TextWrapping="Wrap" />
          <StackPanel x:Name="LocalVideoItems" Spacing="16" />
          <Button x:Name="LocalLoadMore" IsVisible="False" Content="Show more videos" Click="LocalLoadMore_Click" HorizontalAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DetailsPage" Grid.Row="1" IsVisible="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto,*">
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18">
          <Border CornerRadius="18" Background="#1D1B2D" Padding="18">
            <Grid ColumnDefinitions="110,*">
              <Border Background="#302742" CornerRadius="10" ClipToBounds="True" Width="110" Height="165" VerticalAlignment="Top">
                <Grid><TextBlock Text="B X" Foreground="#A78BFA" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="DetailPoster" Stretch="UniformToFill" /></Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="12">
                <TextBlock x:Name="DetailKind" Text="MOVIE" Foreground="#B69AFF" LetterSpacing="2" FontSize="11" />
                <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailFacts" Foreground="#D2CBDD" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailGenres" Classes="muted" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" LineHeight="23" />
              </StackPanel>
            </Grid>
          </Border>
          </ScrollViewer>
          <Grid x:Name="TitleContentGrid" Grid.Row="1" ColumnDefinitions="2*,3*">
            <Grid x:Name="EpisodeSection" IsVisible="False" RowDefinitions="Auto,*" Margin="0,0,18,0">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBlock Text="Episodes" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox x:Name="SeasonPicker" Grid.Column="1" MinWidth="120" SelectionChanged="SeasonChanged" />
              </Grid>
              <ScrollViewer x:Name="EpisodeScroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="EpisodeItems" />
              </ScrollViewer>
            </Grid>
            <ScrollViewer x:Name="StreamScroller" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12" Margin="0,0,12,0">
                <Button x:Name="MovieSourcesButton" Content="Find streams" Classes="primary" Click="FindStreams_Click" HorizontalAlignment="Left" />

                <Border x:Name="EpisodePreparingPanel" IsVisible="False" Background="#292139" BorderBrush="#574371" BorderThickness="1" CornerRadius="12" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Loading next episode…" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock x:Name="EpisodePreparingTitle" TextWrapping="Wrap" Foreground="#D9CFEB" />
                    <TextBlock Text="Sources appear below as providers respond." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Button Content="Cancel" Classes="playerAction" Click="CancelEpisodePreparation_Click" ToolTip.Tip="Cancel episode preparation" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
          <StackPanel x:Name="DetailBusy" IsVisible="False" Spacing="8">
            <ProgressBar IsIndeterminate="True" Height="3" Foreground="#A78BFA" />
            <TextBlock x:Name="DetailLoadingText" Text="Loading title…" Classes="muted" />
          </StackPanel>
          <TextBlock x:Name="DetailMessage" Classes="muted" TextWrapping="Wrap" />
          <Button x:Name="DetailRetry" Content="Retry streams" Click="FindStreams_Click" IsVisible="False" HorizontalAlignment="Left" />
          <TextBlock x:Name="StreamHeading" TextWrapping="Wrap" Text="Available streams" FontSize="23" FontWeight="SemiBold" IsVisible="False" />
          <WrapPanel><Button x:Name="SuggestedSource" IsVisible="False" Content="Try suggested source" Classes="primary" Click="SuggestedSource_Click" Margin="0,0,14,0" /><CheckBox x:Name="AutoNextSource" IsChecked="True" Content="Try another source if this one stalls (up to 3 attempts)" VerticalAlignment="Center" /></WrapPanel>
          <TextBlock Text="Suggested order uses available quality, size and advertised seed counts. Availability is checked when you play." Classes="muted" TextWrapping="Wrap" />
          <StackPanel x:Name="StreamItems" Spacing="10" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </ScrollViewer>
      <Grid x:Name="PlayerPage" Grid.Row="1" IsVisible="False" Background="Black">
        <Border x:Name="VideoFrame" Background="Black" CornerRadius="12" ClipToBounds="True">
          <local:VideoSurfaceView x:Name="VideoSurface" IsVisible="False">
            <Grid x:Name="PlayerOverlay" Background="Transparent" Focusable="True">
              <Border x:Name="PlayerLoading" IsVisible="False" Background="Black" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="12" Margin="24" MaxWidth="560">
                  <TextBlock x:Name="PlayerLoadingTitle" Text="Opening video…" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock x:Name="PlayerLoadingDetail" Foreground="#DED7EA" TextAlignment="Center" TextWrapping="Wrap" />
                  <ProgressBar IsIndeterminate="True" Width="160" Height="3" Foreground="#B69AFF" Margin="0,6" />
                  <TextBlock x:Name="PlayerLoadingHint" Text="Preparing playback" FontSize="12" Foreground="#A8A1B8" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <StackPanel x:Name="PlayerEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">
                <TextBlock Text="Ready when you are." FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Open a video or drop a file here to start watching." Foreground="#B5AFC6" HorizontalAlignment="Center" />
              </StackPanel>
              <Border x:Name="CaptionPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="32,0,32,180" Padding="14,6" CornerRadius="6" IsVisible="False" IsHitTestVisible="False" MaxWidth="1100">
                <TextBlock x:Name="CaptionText" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="8">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="4" Color="Black" OffsetX="0" OffsetY="2" /></TextBlock.Effect>
                </TextBlock>
              </Border>
              <Border x:Name="TorrentPanel" IsVisible="False" Background="#ED201A30" CornerRadius="10" Padding="14" Margin="16" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="670">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="6"><TextBlock x:Name="TorrentState" Text="Preparing torrent…" TextWrapping="Wrap" /><TextBlock x:Name="TorrentDetails" FontSize="11" Foreground="#C8BFDC" TextWrapping="Wrap" /><TextBlock x:Name="TorrentBufferDetails" FontSize="11" Foreground="#D4CEE4" TextWrapping="Wrap" /><StackPanel x:Name="SourceSwitchActions" IsVisible="False" Spacing="6"><TextBlock x:Name="SourceSwitchMessage" TextWrapping="Wrap" /><WrapPanel><Button Content="Try now" Click="TryNextSource_Click" Margin="0,0,8,0" /><Button Content="Cancel switch" Click="CancelSwitch_Click" /></WrapPanel></StackPanel><ProgressBar x:Name="TorrentProgress" IsIndeterminate="True" Height="3" /></StackPanel>
                  <Button Grid.Column="1" Content="Stop torrent" Click="CancelTorrent_Click" Margin="14,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border x:Name="PlaybackNotice" Background="#DD201A30" CornerRadius="10" Padding="18,10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20" IsVisible="False" IsHitTestVisible="False">
                <TextBlock x:Name="PlaybackNoticeText" TextWrapping="Wrap" />
              </Border>
              <Border x:Name="PlaybackWaiting" IsVisible="False" Background="#DF161620" CornerRadius="12" Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel Spacing="10"><TextBlock x:Name="PlaybackWaitingLabel" Text="Buffering…" HorizontalAlignment="Center" /><ProgressBar IsIndeterminate="True" Width="140" Height="3" Foreground="#B69AFF" /></StackPanel>
              </Border>
              <Border x:Name="PlayerControls" VerticalAlignment="Bottom" Padding="18,28,18,16">
                <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#00101018" Offset="0" /><GradientStop Color="#F0101018" Offset="0.25" /><GradientStop Color="#FA101018" Offset="1" /></LinearGradientBrush></Border.Background>
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button x:Name="PlayerBackButton" Content="← Back" Classes="playerAction" Click="NavigateBack_Click" IsVisible="False" Margin="0,0,12,0" ToolTip.Tip="Back (Alt+Left)" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock x:Name="NowPlaying" Text="Open a file to start watching" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock x:Name="PlayerTrackSummary" Text="Your video. Your controls." Foreground="#A8A1B8" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="playerAction" Click="MinimizePlayer_Click" ToolTip.Tip="Keep watching while browsing" AutomationProperties.Name="Minimize to mini-player" Margin="12,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="7"><Path Width="18" Height="16" Stroke="White" StrokeThickness="1.6" Data="M 1,1 L 17,1 L 17,15 L 1,15 Z M 9,8 L 15,8 L 15,13 L 9,13 Z" /><TextBlock Text="Mini-player" /></StackPanel>
                    </Button>
                  </Grid>
                  <Border x:Name="EpisodeAutoplayPanel" IsVisible="False" Background="#E82B233C" CornerRadius="8" Padding="10">
                    <WrapPanel><TextBlock x:Name="EpisodeAutoplayText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Content="Play now" Click="NextEpisode_Click" Margin="0,0,8,0" /><Button Content="Cancel" Click="CancelEpisodeAutoplay_Click" /></WrapPanel>
                  </Border>
                  <Slider x:Name="SeekBar" Classes="playerSlider" AutomationProperties.Name="Playback position" Minimum="0" Maximum="1000" Value="0" />
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Button x:Name="PlayButton" Classes="playerIcon primary" Click="Play_Click" ToolTip.Tip="Play (Space)" AutomationProperties.Name="Play">
                        <Path x:Name="PlayIcon" Width="20" Height="20" Stretch="Uniform" Fill="White" Data="M 6,3 L 21,12 L 6,21 Z" />
                      </Button>
                      <Button Classes="playerIcon" Click="Back_Click" ToolTip.Tip="Back 10 seconds (Left)" AutomationProperties.Name="Back 10 seconds">
                        <Grid><Path Width="24" Height="24" Stroke="White" StrokeThickness="1.7" Data="M 5,7 A 9,9 0 1 1 3,14 M 5,2 L 5,8 L 11,8" /><TextBlock Text="10" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" /></Grid>
                      </Button>
                      <Button Classes="playerIcon" Click="Forward_Click" ToolTip.Tip="Forward 10 seconds (Right)" AutomationProperties.Name="Forward 10 seconds">
                        <Grid><Path Width="24" Height="24" Stroke="White" StrokeThickness="1.7" Data="M 19,7 A 9,9 0 1 0 21,14 M 19,2 L 19,8 L 13,8" /><TextBlock Text="10" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" /></Grid>
                      </Button>
                      <Button x:Name="NextEpisodeButton" Classes="playerIcon" IsVisible="False" Click="NextEpisode_Click" ToolTip.Tip="Next episode" AutomationProperties.Name="Next episode">
                        <Path Width="20" Height="20" Fill="White" Data="M 3,3 L 15,10 L 3,17 Z M 16,3 L 19,3 L 19,17 L 16,17 Z" />
                      </Button>
                      <TextBlock x:Name="TimeLabel" Text="00:00 / --:--" Foreground="#C8C3D5" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Button x:Name="MuteButton" Classes="playerIcon" Click="Mute_Click" ToolTip.Tip="Mute (M)" AutomationProperties.Name="Mute">
                        <Path x:Name="VolumeIcon" Width="24" Height="24" Stroke="White" StrokeThickness="1.7" Data="M 3,9 L 7,9 L 12,4 L 12,20 L 7,15 L 3,15 Z M 16,8 Q 20,12 16,16 M 19,4 Q 26,12 19,20" />
                      </Button>
                      <Slider x:Name="VolumeBar" Classes="playerSlider" Minimum="0" Maximum="100" Value="80" Width="72" Margin="0,0,10,0" ToolTip.Tip="Volume" AutomationProperties.Name="Volume" />
                      <Button Classes="playerIcon" Click="Captions_Click" ToolTip.Tip="Subtitle settings · C toggles subtitles" AutomationProperties.Name="Subtitle settings">
                        <Path Width="24" Height="24" Stroke="White" StrokeThickness="1.7" Data="M 3,4 L 21,4 L 21,20 L 3,20 Z M 10,9 C 5,7 5,17 10,15 M 18,9 C 13,7 13,17 18,15" />
                      </Button>
                      <Button Classes="playerIcon" Click="Settings_Click" ToolTip.Tip="Playback settings (S)" AutomationProperties.Name="Playback settings">
                        <Path Width="24" Height="24" Stroke="White" StrokeThickness="1.7" Data="M 3,6 L 9,6 M 15,6 L 21,6 M 3,12 L 14,12 M 20,12 L 21,12 M 3,18 L 5,18 M 11,18 L 21,18 M 9,3 L 15,3 L 15,9 L 9,9 Z M 14,9 L 20,9 L 20,15 L 14,15 Z M 5,15 L 11,15 L 11,21 L 5,21 Z" />
                      </Button>
                      <Button x:Name="FullscreenButton" Classes="playerIcon" Click="Fullscreen_Click" ToolTip.Tip="Fullscreen (F)" AutomationProperties.Name="Fullscreen">
                        <Path x:Name="FullscreenIcon" Width="24" Height="24" Stroke="White" StrokeThickness="1.7" Data="M 3,9 L 3,3 L 9,3 M 15,3 L 21,3 L 21,9 M 21,15 L 21,21 L 15,21 M 9,21 L 3,21 L 3,15" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <Border x:Name="MiniControls" IsVisible="False" Background="#E8101018" VerticalAlignment="Bottom" Padding="10,8">
                <StackPanel Spacing="6">
                  <StackPanel x:Name="MiniEpisodeAutoplayPanel" IsVisible="False" Spacing="4">
                    <TextBlock x:Name="MiniEpisodeAutoplayText" TextWrapping="Wrap" FontSize="11" />
                    <WrapPanel><Button Content="Play now" Click="NextEpisode_Click" Padding="8,4" Margin="0,0,8,0" /><Button Content="Cancel" Click="CancelEpisodeAutoplay_Click" Padding="8,4" /></WrapPanel>
                  </StackPanel>
                  <TextBlock x:Name="MiniTitle" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button x:Name="MiniPlayButton" Content="Pause" Click="Play_Click" Padding="10,5" />
                    <Button Grid.Column="2" Content="Restore" Click="RestorePlayer_Click" Padding="10,5" Margin="8,0" />
                    <Button Grid.Column="3" Content="×" Click="CloseMiniPlayer_Click" Padding="10,5" ToolTip.Tip="Stop playback and close mini-player" AutomationProperties.Name="Close mini-player" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border x:Name="CaptionQuickPanel" IsVisible="False" Background="#F51E1A2B" BorderBrush="#423451" BorderThickness="1" CornerRadius="14" Width="330" MaxHeight="330" Margin="16,16,16,145" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="16">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Subtitles" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="×" Classes="playerAction" Click="CloseCaptionQuick_Click" AutomationProperties.Name="Close subtitle picker" /></Grid>
                  <ComboBox x:Name="QuickSubtitleTrackPicker" HorizontalAlignment="Stretch" SelectionChanged="QuickSubtitleTrackChanged" AutomationProperties.Name="Quick subtitle track">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="Online captions are fetched in memory. No subtitle file is saved." Foreground="#AAA0BA" FontSize="11" TextWrapping="Wrap" />
                  <Button Content="More subtitle settings…" Classes="playerAction" Click="MoreSubtitleSettings_Click" HorizontalAlignment="Stretch" />
                </StackPanel>
                </ScrollViewer>
              </Border>
              <Border x:Name="PlayerSettingsPanel" IsVisible="False" Background="#F51E1A2B" BorderBrush="#423451" BorderThickness="1" CornerRadius="14" Width="350" MaxHeight="480" Margin="16,16,16,145" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="18">
                <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto"><Button x:Name="SubtitleSearchBack" IsVisible="False" Content="←" Click="SubtitleSearchBack_Click" ToolTip.Tip="Back to subtitles" AutomationProperties.Name="Back to subtitles" Padding="8" Margin="0,0,8,0" /><TextBlock Grid.Column="1" x:Name="PlayerSettingsTitle" Text="Playback settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="2" Content="Close" Click="CloseSettings_Click" /></Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <Button x:Name="AudioSettingsTab" Content="Audio &amp; playback" Classes="playerAction" Click="AudioSettingsTab_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      <Button x:Name="SubtitleSettingsTab" Grid.Column="1" Content="Subtitles" Classes="playerAction" Click="SubtitleSettingsTab_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="PlaybackSettingsSection" Spacing="12">
                      <TextBlock Text="Playback speed" Foreground="#BFB5D1" />
                      <ComboBox x:Name="SpeedBox" SelectedIndex="2" HorizontalAlignment="Stretch" AutomationProperties.Name="Playback speed">
                        <ComboBoxItem Content="0.5×" /><ComboBoxItem Content="0.75×" /><ComboBoxItem Content="1×" /><ComboBoxItem Content="1.25×" /><ComboBoxItem Content="1.5×" /><ComboBoxItem Content="2×" />
                      </ComboBox>
                      <CheckBox x:Name="AutoplayEpisodesCheck" Content="Autoplay next episode" />
                      <TextBlock x:Name="AudioSettingsHeading" Text="Audio track" Foreground="#BFB5D1" />
                      <ComboBox x:Name="AudioTrackPicker" HorizontalAlignment="Stretch" SelectionChanged="AudioTrackChanged" AutomationProperties.Name="Audio track">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <StackPanel x:Name="StreamAudioSection" Spacing="6" IsVisible="False">
                        <TextBlock Text="Stream audio language" Foreground="#BEB4D1" />
                        <ComboBox x:Name="StreamAudioPicker" HorizontalAlignment="Stretch" SelectionChanged="StreamAudioChanged" />
                      </StackPanel>
                      <Button Content="Add audio file…" Click="LoadAudio_Click" HorizontalAlignment="Left" />
                      <TextBlock x:Name="ExternalAudioLabel" Text="Use an audio file that matches this video's cut." FontSize="11" Foreground="#AAA0BA" TextWrapping="Wrap" />
                      <TextBlock Text="Audio delay (seconds)" Foreground="#BFB5D1" />
                      <NumericUpDown x:Name="AudioDelayInput" Minimum="-300" Maximum="300" Increment="0.05" FormatString="0.00" Value="0" ValueChanged="AudioDelayChanged" />
                      <TextBlock Text="Positive = later · Negative = earlier" FontSize="11" Foreground="#9E95B0" />
                    </StackPanel>
                    <StackPanel x:Name="SubtitleSettingsSection" Spacing="12" IsVisible="False">
                      <Button x:Name="OnlineSubtitleButton" Content="Search online…" Classes="primary" Click="OnlineSubtitles_Click" HorizontalAlignment="Stretch" />
                      <TextBlock Text="Subtitle track" Foreground="#BFB5D1" />
                      <ComboBox x:Name="SubtitleTrackPicker" HorizontalAlignment="Stretch" SelectionChanged="SubtitleTrackChanged" AutomationProperties.Name="Subtitle track">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Text="Embedded = in the video · Online = fetched from a provider · File = added locally. Your language choice is remembered for this show." Foreground="#AAA0BA" FontSize="11" TextWrapping="Wrap" />
                      <Button Content="Load subtitle file…" Click="Subtitle_Click" HorizontalAlignment="Left" />
                      <TextBlock Text="Subtitle delay (seconds)" Foreground="#BFB5D1" />
                      <NumericUpDown x:Name="SubtitleDelayInput" Minimum="-300" Maximum="300" Increment="0.05" FormatString="0.00" Value="0" ValueChanged="SubtitleDelayChanged" />
                      <TextBlock Text="Positive = later · Negative = earlier" FontSize="11" Foreground="#9E95B0" />
                      <TextBlock Text="Text subtitle appearance" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                      <TextBlock Text="For external SRT / VTT files. Embedded tracks keep their original styling." FontSize="11" Foreground="#AAA0BA" TextWrapping="Wrap" />
                      <Grid ColumnDefinitions="*,*">
                        <StackPanel Spacing="6" Margin="0,0,8,0"><TextBlock Text="Size" /><ComboBox x:Name="SubtitleSizePicker" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="SubtitleStyleChanged"><ComboBoxItem Content="Small" /><ComboBoxItem Content="Medium" /><ComboBoxItem Content="Large" /><ComboBoxItem Content="Extra large" /></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Color" /><ComboBox x:Name="SubtitleColorPicker" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="SubtitleStyleChanged"><ComboBoxItem Content="White" /><ComboBoxItem Content="Yellow" /><ComboBoxItem Content="Mint" /></ComboBox></StackPanel>
                      </Grid>
                      <CheckBox x:Name="SubtitleBackgroundCheck" Content="Dark background" IsChecked="True" IsCheckedChanged="SubtitleBackgroundChanged" />
                      <TextBlock Text="C: subtitles on / off · G / H: earlier / later" FontSize="11" Foreground="#9E95B0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="OnlineSubtitleSection" IsVisible="False" Spacing="10">
                      <TextBlock Text="Find a matching title, choose a language, then load a subtitle. OpenSubtitles and your subtitle add-ons supply results." FontSize="11" Foreground="#BFB5D1" TextWrapping="Wrap" />
                      <Button x:Name="CurrentVideoSubtitlesButton" Content="Find for this video" Click="CurrentVideoSubtitles_Click" HorizontalAlignment="Stretch" IsVisible="False" />
                      <TextBox x:Name="SubtitleQueryInput" TextChanged="SubtitleSearchInputsChanged" Watermark="Movie / series title or IMDb ID" KeyDown="SubtitleQuery_KeyDown" AutomationProperties.Name="Subtitle title search" />
                      <ComboBox x:Name="SubtitleMediaType" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="SubtitleMediaTypeChanged" AutomationProperties.Name="Subtitle media type"><ComboBoxItem Content="Movie" /><ComboBoxItem Content="Series" /></ComboBox>
                      <Grid x:Name="SubtitleEpisodeFields" IsVisible="False" ColumnDefinitions="*,*">
                        <StackPanel Spacing="4" Margin="0,0,8,0"><TextBlock Text="Season" FontSize="11" /><NumericUpDown x:Name="SubtitleSeason" ValueChanged="SubtitleSearchEpisodeChanged" Minimum="0" Maximum="999" Value="1" FormatString="0" AutomationProperties.Name="Subtitle season" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Episode" FontSize="11" /><NumericUpDown x:Name="SubtitleEpisode" ValueChanged="SubtitleSearchEpisodeChanged" Minimum="1" Maximum="9999" Value="1" FormatString="0" AutomationProperties.Name="Subtitle episode" /></StackPanel>
                      </Grid>
                      <Button Content="Search titles" Click="SearchSubtitleTitles_Click" Classes="primary" HorizontalAlignment="Stretch" />
                      <ProgressBar x:Name="OnlineSubtitleBusy" IsVisible="False" IsIndeterminate="True" Height="3" Foreground="#B69AFF" />
                      <TextBlock x:Name="OnlineSubtitleMessage" Foreground="#CFC5DF" TextWrapping="Wrap" FontSize="12" />
                      <StackPanel x:Name="SubtitleTitleResults" Spacing="8" />
                      <ComboBox x:Name="OnlineSubtitleLanguage" IsVisible="False" HorizontalAlignment="Stretch" SelectionChanged="OnlineSubtitleLanguageChanged" AutomationProperties.Name="Subtitle language" />
                      <TextBlock x:Name="OnlineSubtitleResultCount" IsVisible="False" Foreground="#BFB5D1" FontSize="11" />
                      <StackPanel x:Name="OnlineSubtitleResults" Spacing="8" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Grid>
          </local:VideoSurfaceView>
        </Border>
      </Grid>
      <ScrollViewer x:Name="AddonsPage" Grid.Row="1" IsVisible="False">
        <StackPanel Spacing="16">
          <TextBlock Text="Connect your catalogs" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Install an existing Stremio add-on using its HTTPS manifest URL. Configure add-ons on their provider’s website first." TextWrapping="Wrap" Classes="muted" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="ManifestInput" Watermark="https://your-addon.example/manifest.json" />
            <Button x:Name="InstallButton" Grid.Column="1" Content="Install" Classes="primary" Click="Install_Click" Margin="12,0,0,0" />
          </Grid>
          <TextBlock Text="Connection checks describe this device only. Community reports open on stremio-addons.net; they may cover a different hosted instance." TextWrapping="Wrap" Classes="muted" />
          <StackPanel x:Name="AddonItems" Spacing="12" />
          <Border Background="#211C30" CornerRadius="12" Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="Cloudstream · Experimental" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="Add a repository and install extensions. Compatibility varies; browser verification and extension settings are not supported yet. Extensions execute code: install only those you trust." TextWrapping="Wrap" Classes="muted" />
              <TextBlock Text="Optional bridge: SkyStream cs3_engine (GPL-3.0) and Temurin Java. Downloaded separately; source and license links are in the bridge folder." TextWrapping="Wrap" Classes="muted" />
              <Button x:Name="CloudstreamDownload" Content="Download Cloudstream bridge" Click="CloudstreamDownload_Click" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="CloudstreamRepositoryInput" Watermark="Repository link (HTTPS, cloudstreamrepo:// or GitHub)" />
                <Button x:Name="CloudstreamRepositoryButton" Grid.Column="1" Content="Read repository" Click="CloudstreamRepository_Click" Margin="12,0,0,0" />
              </Grid>
              <TextBlock x:Name="CloudstreamStatus" Text="No extensions are bundled. Add a repository to get started." TextWrapping="Wrap" />
              <TextBlock x:Name="CloudstreamInstalledHeading" FontWeight="SemiBold" />
              <TextBlock x:Name="CloudstreamInstalledEmpty" Text="No extensions installed yet." Classes="muted" />
              <WrapPanel x:Name="CloudstreamInstalledItems" />
              <TextBlock x:Name="CloudstreamAvailableHeading" FontWeight="SemiBold" />
              <TextBlock x:Name="CloudstreamAvailableEmpty" Text="Read a repository to find extensions." Classes="muted" />
              <WrapPanel x:Name="CloudstreamAvailableItems" />
            </StackPanel>
          </Border>
          <Border Background="#252036" CornerRadius="12" Padding="18">
            <TextBlock Text="Catalogs help you discover titles. Playback needs a compatible stream provider. A catalog connection alone does not supply playable videos." TextWrapping="Wrap" Foreground="#C8BFDC" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border x:Name="StatusFooter" Grid.Column="1" Grid.Row="1" Background="#191923" Padding="24,10">
      <TextBlock x:Name="StatusLabel" Text="Ready • Open a local video to begin" Classes="muted" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
